<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CodeBrix.Audio.Core.MitLicenseForever" Version="$(CodeBrixAudioCoreVersion)" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <Compile Include="../../src/CodeBrix.Audio.Android/Internal/MidiByteParser.cs" Link="MidiByteParser.cs" />
    <None Include="../../artifacts/native/host/libcodebrix_miniaudio.so" Link="libcodebrix_miniaudio.so" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Assets/*" Link="Assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
