<Project Sdk="Microsoft.NET.Sdk">

  <!--
    HOST tests - they run on the development machine, not on Android.

    The library targets net10.0-android36.1, which a desktop test project cannot reference,
    so there is no ProjectReference here. Instead this project:
      * compiles the platform-independent library source files it tests -
        Internal/MidiByteParser.cs and Internal/AssetStamp.cs - as linked files (they are
        internal; the link makes them visible without InternalsVisibleTo), and
      * exercises the codec half of the native library through a HOST build of the same C
        sources, via the shared engine's codec factory from the pinned Core package.

    That host build is COMMITTED, under runtimes/<rid>/native/ beside this file, in the
    same layout Core's native loader probes at run time. Today there is one, linux-x64,
    built by tools/test-host.sh (CODEBRIX_CODECS_ONLY=ON, no Android toolchain). The codec
    tests skip themselves on any other platform; the MIDI parser tests run everywhere. A
    change under native/ means re-running tools/test-host.sh and committing the new .so.
    See MAINTAINER-README.txt, "TESTING".
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.248.1071" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same Core pin as the library csproj; raise both together. -->
    <PackageReference Include="CodeBrix.Audio.Core.MitLicenseForever" Version="1.0.269.1270" />
    <Compile Include="..\..\src\CodeBrix.Audio.Android\Internal\AssetStamp.cs" Link="Internal\AssetStamp.cs" />
    <Compile Include="..\..\src\CodeBrix.Audio.Android\Internal\MidiByteParser.cs" Link="Internal\MidiByteParser.cs" />
    <None Include="..\Assets\*" Link="Assets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The committed host codec libraries, copied to the output under runtimes/<rid>/native/ -
    the layout Core's DllImportResolver probes. Remove-then-Include so the explicit metadata
    does not collide with the SDK's default None glob. A glob, so a platform with no
    library here never breaks the build.
  -->
  <ItemGroup>
    <None Remove="runtimes\**\*" />
    <None Include="runtimes\**\*" Link="runtimes\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
