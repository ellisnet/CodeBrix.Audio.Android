<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android36.1</TargetFramework>
    <SupportedOSPlatformVersion>33.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.codebrix.audio.diagnostics</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AndroidAudioVersion Condition="'$(AndroidAudioVersion)' == ''">1.0.269.1101</AndroidAudioVersion>
    <OpusVersion Condition="'$(OpusVersion)' == ''">1.0.269.1101</OpusVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Deliberately test the packed Android artifact, including its native AAR. -->
    <PackageReference Include="CodeBrix.Audio.Android.ApacheLicenseForever" Version="$(AndroidAudioVersion)" />
    <PackageReference Include="CodeBrix.Audio.ModestSynth.MitLicenseForever" Version="$(CodeBrixAudioCoreVersion)" />
    <PackageReference Include="CodeBrix.Audio.Opus.BsdLicenseForever" Version="$(OpusVersion)" />
    <AndroidAsset Include="../../tests/Assets/tone.*" Link="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
