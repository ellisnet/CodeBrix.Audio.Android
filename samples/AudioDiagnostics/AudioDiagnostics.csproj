<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android36.1</TargetFramework>
    <SupportedOSPlatformVersion>33.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.codebrix.audio.diagnostics</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- AndroidAudioVersion: the published CodeBrix.Audio.Android package. Until it is on nuget.org,
         pass the locally packed version and a local feed on the command line (see DEVELOPMENT.md). -->
    <AndroidAudioVersion Condition="'$(AndroidAudioVersion)' == ''">1.0.269.1101</AndroidAudioVersion>
    <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' and Exists('/usr/lib/jvm/java-21-openjdk-amd64')">/usr/lib/jvm/java-21-openjdk-amd64</JavaSdkDirectory>
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and Exists('/home/jeremy/Android/Sdk')">/home/jeremy/Android/Sdk</AndroidSdkDirectory>
  </PropertyGroup>
  <ItemGroup>
    <!-- Deliberately test the packed Android artifact, including its native AAR. -->
    <PackageReference Include="CodeBrix.Audio.Android.ApacheLicenseForever" Version="$(AndroidAudioVersion)" />
    <PackageReference Include="CodeBrix.Audio.ModestSynth.MitLicenseForever" Version="1.0.269.1270" />
    <PackageReference Include="CodeBrix.Audio.Opus.BsdLicenseForever" Version="1.0.269.1352" />
    <AndroidAsset Include="../../tests/Assets/tone.*" Link="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
